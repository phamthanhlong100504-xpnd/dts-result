# Template only; Maven/Spring Boot does not automatically load .env.
SERVER_PORT=8086
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5438/dts_result_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
# Canonical docs/db migrations own schema changes. Keep Hibernate DDL disabled.
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_SECRET=
JWT_ISSUER=dts-identity-service
EUREKA_CLIENT_ENABLED=false
RESULT_PUBLIC_PROFILE_TOPIC=user-events
