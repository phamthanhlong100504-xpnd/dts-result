-- Canonical entrypoint. psql -X -v ON_ERROR_STOP=1 -v expected_database=NAME -f docs/db/apply-schema.psql
-- Check schema-manifest.json hashes with the supplied runner before applying.
\set ON_ERROR_STOP on
\if :{?expected_database}
\else
\set expected_database dts_result_db
\endif
BEGIN;
SET LOCAL lock_timeout='5s';
SET LOCAL statement_timeout='120s';
SET LOCAL search_path=public,pg_catalog;
SELECT set_config('dts.expected_database', :'expected_database', true);
DO $body$
BEGIN
 IF current_database()<>current_setting('dts.expected_database') THEN
   RAISE EXCEPTION 'Wrong target database; no migration accepted';
 END IF;
 IF current_setting('server_version_num')::integer<130000 THEN
   RAISE EXCEPTION 'PostgreSQL 13 or later is required';
 END IF;
END;
$body$;
SELECT pg_advisory_xact_lock(12002613);
CREATE TABLE IF NOT EXISTS public.dts_result_schema_history(
 version varchar(20) PRIMARY KEY,
 script varchar(255) NOT NULL,
 checksum char(64) NOT NULL,
 applied_at timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP
);

SELECT set_config('dts.migration_checksum','2ACEED51CD88FA282970176F85E6E7925AF70B21381CED18804F536E8D2730A2',true);
DO $body$
BEGIN
 IF EXISTS(SELECT 1 FROM public.dts_result_schema_history WHERE version='V001'
   AND (checksum<>current_setting('dts.migration_checksum') OR script<>'V001__baseline_entity_schema.sql')) THEN
   RAISE EXCEPTION 'Executed migration V001 differs from this version; do not edit migration history';
 END IF;
END;
$body$;
SELECT NOT EXISTS(SELECT 1 FROM public.dts_result_schema_history WHERE version='V001') AS apply_v001 \gset
\if :apply_v001
\ir migrations/V001__baseline_entity_schema.sql
INSERT INTO public.dts_result_schema_history(version,script,checksum)
 VALUES('V001','V001__baseline_entity_schema.sql','2ACEED51CD88FA282970176F85E6E7925AF70B21381CED18804F536E8D2730A2');
\endif

SELECT set_config('dts.migration_checksum','51C2829D97ED4C148307EDFA0B13866A2F8810B3FEF0A75EF5E37B03F08EDC26',true);
DO $body$
BEGIN
 IF EXISTS(SELECT 1 FROM public.dts_result_schema_history WHERE version='V002'
   AND (checksum<>current_setting('dts.migration_checksum') OR script<>'V002__screen12_contract_integrity.sql')) THEN
   RAISE EXCEPTION 'Executed migration V002 differs from this version; do not edit migration history';
 END IF;
END;
$body$;
SELECT NOT EXISTS(SELECT 1 FROM public.dts_result_schema_history WHERE version='V002') AS apply_v002 \gset
\if :apply_v002
\ir migrations/V002__screen12_contract_integrity.sql
INSERT INTO public.dts_result_schema_history(version,script,checksum)
 VALUES('V002','V002__screen12_contract_integrity.sql','51C2829D97ED4C148307EDFA0B13866A2F8810B3FEF0A75EF5E37B03F08EDC26');
\endif

SELECT set_config('dts.migration_checksum','4F3916D7852EF3D71383AB416633028393D961C203E1BB08673CAD34CFC58276',true);
DO $body$
BEGIN
 IF EXISTS(SELECT 1 FROM public.dts_result_schema_history WHERE version='V003'
   AND (checksum<>current_setting('dts.migration_checksum') OR script<>'V003__screen13_exam_history.sql')) THEN
   RAISE EXCEPTION 'Executed migration V003 differs from this version; do not edit migration history';
 END IF;
END;
$body$;
SELECT NOT EXISTS(SELECT 1 FROM public.dts_result_schema_history WHERE version='V003') AS apply_v003 \gset
\if :apply_v003
\ir migrations/V003__screen13_exam_history.sql
INSERT INTO public.dts_result_schema_history(version,script,checksum)
 VALUES('V003','V003__screen13_exam_history.sql','4F3916D7852EF3D71383AB416633028393D961C203E1BB08673CAD34CFC58276');
\endif

SELECT set_config('dts.migration_checksum','2DBDA73B82AF1B53C098BD72970FA1CD2FCBA2FD8419E6AE6C47AF76BA0E5A06',true);
DO $body$
BEGIN
 IF EXISTS(SELECT 1 FROM public.dts_result_schema_history WHERE version='V004'
   AND (checksum<>current_setting('dts.migration_checksum') OR script<>'V004__screen14_exp_and_screen16_analytics.sql')) THEN
   RAISE EXCEPTION 'Executed migration V004 differs from this version; do not edit migration history';
 END IF;
END;
$body$;
SELECT NOT EXISTS(SELECT 1 FROM public.dts_result_schema_history WHERE version='V004') AS apply_v004 \gset
\if :apply_v004
\ir migrations/V004__screen14_exp_and_screen16_analytics.sql
INSERT INTO public.dts_result_schema_history(version,script,checksum)
 VALUES('V004','V004__screen14_exp_and_screen16_analytics.sql','2DBDA73B82AF1B53C098BD72970FA1CD2FCBA2FD8419E6AE6C47AF76BA0E5A06');
\endif

\ir verify-schema.sql
COMMIT;
SELECT json_build_object('database',current_database(),'service','dts-result','schema_versions',(SELECT count(*) FROM public.dts_result_schema_history),'schema_verified',true);
